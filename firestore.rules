rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validCustomerOrder(orderId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'customer', 'phone', 'address', 'note',
          'items', 'total', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'customer', 'phone', 'address', 'note',
          'items', 'total', 'status', 'createdAt'
        ])
        && data.id == orderId
        && data.customer is string
        && data.customer.size() > 0
        && data.customer.size() <= 120
        && data.phone is string
        && data.phone.size() >= 8
        && data.phone.size() <= 20
        && data.address is string
        && data.address.size() > 0
        && data.address.size() <= 300
        && data.note is string
        && data.note.size() <= 500
        && data.items is string
        && data.items.size() > 0
        && data.items.size() <= 1500
        && data.total is number
        && data.total > 0
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    match /admins/{adminUid} {
      allow get: if signedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validCustomerOrder(orderId);
      allow read, update, delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }
  }
}
